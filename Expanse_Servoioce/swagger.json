{
  "openapi": "3.0.0",
  "info": {
    "title": "Expanse Service API",
    "version": "1.0.0",
    "description": "A simple Express.js API documentation"
  },
  "servers": [
    {
      "url": "http://localhost:8060",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1/expanse": {
      "get": {
        "summary": "Returns a list of Expanses",
        "responses": {
          "200": {
            "description": "A JSON array of Exapnse Deatsils",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "post":{
        "summary": "Add a new Expanse",
        "responses": {
          "200": {
            "description": "A JSON array of Exapnse Deatsils",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
